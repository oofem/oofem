mpms08.out
Demo of symbolic mpm expression parser 
# 2d heat steady state problem 
#
#  5(T=0)
#  +---------------------------+
#  |                           | q=1
#  +---------------------------+
#  1(T=0)
#

mpmsymbolicstationaryproblem nsteps 1 nvariables 2 nterms 2 nintegrals 2 lhsterms 1 1 rhsterms 1 2 nmodules 1
errorcheck
Variable name "u" interpolation feiquad type scalar quantity "Temperature" size 1 dofs 1 "T_f" # temperature 
Variable name "w" interpolation feiquad type scalar quantity "Temperature" size 1 dofs 1 "T_f" # test function
SymbolicTerm 1 variable "u"  testvariable "w" mmode "_2dHeat" lexpression "Grad(w,gp).T*[[1.0,0.0],[0.0,1.0]]*Grad(u,gp)" rexpression "Grad(w,gp).T*[[1.0,0.0],[0.0,1.0]]*Grad(u,gp)*ru(u, cell, ts)"
SymbolicTerm 2 variable "u"  testvariable "w" mmode "_2dHeat" lexpression "0.0" rexpression "N(w,gp).T*[[1.0]]" # constant heat source
Integral 1 domain 1 set 1 term 1
Integral 2 domain 1 set 2 term 2
#
domain HeatTransfer
outputmanager tstep_all dofman_all element_all
ndofman 4 nelem 2 nbc 1 ncrosssect 1 nic 0 nltf 1 nmat 1 nset 3
node 1 coords 3 0.0 0.0 0.0
node 2 coords 3 3.0 0.0 0.0
node 3 coords 3 0.0 0.3 0.0
node 4 coords 3 3.0 0.3 0.0 
#
q1 1 nodes 4 1 2 4 3 mat 1 crosssect 1
l1 2 nodes 2 2 4  mat 1 crosssect 1
#
simplecs 1 thick 1.0
isole 1 d 1 e 1 n 0.3 talpha 1.
# x-displacement
boundarycondition 1 loadtimefunction 1 set 3 values 1 0.0  dofs 1 10 
#
#
constantfunction 1 f(t) 1
set 1 elements 1 1   
set 2 elements 1 2 
# x-bc defined as nodes on element edges -> important for adaptivity
set 3 elementedges 2 1 4 
#%BEGIN_CHECK% 
#NODE tStep 1 number 2 dof 10 unknown d value 3.0 tolerance 1.e-1
#%END_CHECK%