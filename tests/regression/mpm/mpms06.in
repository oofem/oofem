mpms06.out
Demo of symbolic mpm expression parser 
# 1d heat transfer with constant internal source and prescribed flux 
#test
mpmsymbolicstationaryproblem nsteps 1 nvariables 2 nterms 2 nintegrals 2 lhsterms 1 1 rhsterms 1 2 nmodules 1
errorcheck
Variable name "u" interpolation "feilin" type 1 quantity "Temperature" size 1 dofs 1 10 # temperature 
Variable name "w" interpolation "feilin" type 1 quantity "Temperature" size 1 dofs 1 10 # test function
SymbolicTerm 1 variable "u"  testvariable "w" mmode 25 lexpression "Grad(w,gp).T*[[1.0]]*Grad(u,gp)" rexpression "Grad(w,gp).T*[[1.0]]*Grad(u,gp)*ru(u, cell, ts)"
SymbolicTerm 2 variable "u"  testvariable "w" mmode 25 lexpression "0.0" rexpression "N(w,gp).T*[[1.0]]" # constant heat source
Integral 1 domain 1 set 1 term 1
Integral 2 domain 1 set 1 term 2
#
domain HeatTransfer
outputmanager tstep_all dofman_all element_all
ndofman 2 nelem 1 nbc 2 ncrosssect 1 nic 0 nltf 1 nmat 1 nset 3
node 1 coords 3 0.            0.           0.
node 2 coords 3 3.0           0.           0.
#
l1 1 nodes 2 1 2     mat 1 crosssect 1
#
simplecs 1 thick 1.0
isole 1 d 1 e 1 n 0.3 talpha 1.
# x-displacement
boundarycondition 1 loadtimefunction 1 set 2 values 1 0   dofs 1 10
nodalload 2 loadtimefunction 1 set 3 components 1 -1.0 dofs 1 10
#
#
constantfunction 1 f(t) 1
set 1 elements 1 1 
# x-bc
set 2 nodes 1 1 
set 3 nodes 1 2
#%BEGIN_CHECK% 
#NODE tStep 1 number 2 dof 10 unknown d value 1.5 tolerance 1.e-4
#%END_CHECK%